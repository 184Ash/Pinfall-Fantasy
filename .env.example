# ──────────────────────────────────────────────────────────────
# Pinfall Fantasy — environment variables (TEMPLATE)
# Copy this file to .env.local and fill in your own values.
# .env.local is gitignored and must NEVER be committed.
# ──────────────────────────────────────────────────────────────

# ── Client (Vite) ─────────────────────────────────────────────
# These are inlined into the browser bundle and are PUBLIC by design.
# They are safe to expose ONLY because Row-Level Security protects the
# data behind them. Find both in: Supabase → Project Settings → API.
VITE_SUPABASE_URL=https://your-project-ref.supabase.co
VITE_SUPABASE_ANON_KEY=your-anon-public-key

# ── Server (Vercel serverless function: api/sync-scores.js) ────
# Used only on the server; NEVER bundled to the browser.
# SECURITY: the service_role key bypasses Row-Level Security and has
# full read/write access to the database. Treat it like a root password.
#   • NEVER prefix a service key with VITE_ — Vite would inline it into
#     the public client bundle. Use the plain SUPABASE_ names below.
#   • Set these in Vercel → Project → Settings → Environment Variables,
#     not in any client-readable file.
SUPABASE_URL=https://your-project-ref.supabase.co
SUPABASE_SERVICE_ROLE_KEY=your-service-role-key-server-only
